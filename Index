            'psle-node': {
                title: 'PSLE National Examination',
                body: 'Sat at the end of Primary 6. Each subject is assigned an Achievement Level (AL 1 to 8). Total score ranges from 4 (best) to 32. Total score determines Posting Group, while individual subject scores dictate starting G1/G2/G3 subject levels.'
            },
            'ip-node': {
                title: 'Integrated Programme (IP)',
                body: 'A 6-year seamless pathway leading directly to GCE A-Levels or International Baccalaureate (IB) Diploma without taking O-Levels at Sec 4. Suited for academically strong, self-directed learners (typically PSLE AL 4-8).'
            },
            'pg3-node': {
