<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SG Primary Pathways - PSLE & Post-Primary Education Explorer</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        sgred: {
                            DEFAULT: '#EE2737',
                            light: '#f87171',
                            dark: '#b91c1c'
                        },
                        moeblue: {
                            DEFAULT: '#003366',
                            light: '#1e40af',
                            dark: '#0f172a'
                        },
                        g3green: '#059669',
                        g2blue: '#2563eb',
                        g1amber: '#d97706'
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .gradient-header {
            background: linear-gradient(135deg, #003366 0%, #EE2737 100%);
        }
        .flowchart-node {
            transition: all 0.3s ease;
        }
        .flowchart-node:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: white !important; color: black !important; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 min-h-screen transition-colors duration-200">

    <!-- TOP NAVIGATION HEADER -->
    <header class="no-print sticky top-0 z-50 bg-white/90 dark:bg-slate-900/90 backdrop-blur border-b border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo & Branding -->
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl gradient-header flex items-center justify-center text-white font-bold text-xl shadow-md">
                        SG
                    </div>
                    <div>
                        <h1 class="font-bold text-lg sm:text-xl text-slate-900 dark:text-white leading-tight">
                            SG Primary Pathways <span class="text-xs bg-red-100 text-sgred dark:bg-red-950 dark:text-red-300 font-semibold px-2 py-0.5 rounded-full ml-1">Full SBB Edition</span>
                        </h1>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Post-PSLE & Secondary School Calculator & Navigator</p>
                    </div>
                </div>

                <!-- Right Actions: Dark Mode + Print -->
                <div class="flex items-center space-x-2 sm:space-x-4">
                    <button id="themeToggleBtn" onclick="toggleDarkMode()" class="p-2.5 rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white bg-slate-100 dark:bg-slate-800 transition">
                        <i class="fas fa-moon dark:hidden text-lg"></i>
                        <i class="fas fa-sun hidden dark:inline text-lg text-amber-400"></i>
                        <span class="sr-only">Toggle Theme</span>
                    </button>
                    <button onclick="window.print()" class="flex items-center space-x-2 px-3.5 py-2 rounded-lg bg-moeblue text-white hover:bg-slate-800 text-sm font-medium transition shadow">
                        <i class="fas fa-print"></i>
                        <span class="hidden sm:inline">Print Summary</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- NAVIGATION TABS -->
    <div class="no-print bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 shadow-inner">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="flex space-x-2 sm:space-x-8 overflow-x-auto py-2 scrollbar-none" id="mainTabNav">
                <button onclick="switchTab('calculator')" id="tab-btn-calculator" class="tab-btn active px-3.5 py-2 text-sm font-semibold rounded-lg whitespace-nowrap text-moeblue dark:text-blue-400 bg-blue-50 dark:bg-slate-700 transition">
                    <i class="fas fa-calculator mr-2"></i>1. PSLE & SBB Calculator
                </button>
                <button onclick="switchTab('flowchart')" id="tab-btn-flowchart" class="tab-btn px-3.5 py-2 text-sm font-semibold rounded-lg whitespace-nowrap text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    <i class="fas fa-sitemap mr-2"></i>2. Interactive Flowchart
                </button>
                <button onclick="switchTab('dsa')" id="tab-btn-dsa" class="tab-btn px-3.5 py-2 text-sm font-semibold rounded-lg whitespace-nowrap text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    <i class="fas fa-star mr-2"></i>3. DSA-Sec Tracker
                </button>
                <button onclick="switchTab('comparison')" id="tab-btn-comparison" class="tab-btn px-3.5 py-2 text-sm font-semibold rounded-lg whitespace-nowrap text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                    <i class="fas fa-balance-scale mr-2"></i>4. Pathways Comparison
                </button>
            </nav>
        </div>
    </div>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- ========================================== -->
        <!-- TAB 1: CALCULATOR & SBB ALLOCATION MODULE -->
        <!-- ========================================== -->
        <section id="tab-calculator" class="tab-content block space-y-8">
            <div class="bg-gradient-to-r from-moeblue to-slate-800 text-white rounded-2xl p-6 sm:p-8 shadow-xl">
                <div class="max-w-3xl">
                    <span class="inline-block px-3 py-1 bg-red-500 text-white text-xs font-bold uppercase rounded-full tracking-wider mb-3">MOE Full SBB Framework</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold mb-2">PSLE Score & Subject Banding Calculator</h2>
                    <p class="text-blue-100 text-sm sm:text-base">Input raw target marks or AL grades for Primary 6 subjects to discover calculated PSLE aggregate score, Posting Group placement, and individualized G1/G2/G3 subject allocations.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- INPUT FORM (LEFT 5 COLS) -->
                <div class="lg:col-span-5 bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-md border border-slate-200 dark:border-slate-700 space-y-6">
                    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-4">
                        <h3 class="font-bold text-lg text-slate-900 dark:text-white flex items-center">
                            <i class="fas fa-sliders-h text-sgred mr-2"></i> Subject Grades Input
                        </h3>
                        <button onclick="resetCalculator()" class="text-xs text-slate-500 hover:text-sgred dark:text-slate-400 transition">
                            <i class="fas fa-undo mr-1"></i> Reset
                        </button>
                    </div>

                    <!-- Input Method Switcher -->
                    <div class="flex bg-slate-100 dark:bg-slate-900 p-1 rounded-xl">
                        <button id="modeAL" onclick="setCalcMode('AL')" class="flex-1 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm transition">
                            Select AL Grade (1-8)
                        </button>
                        <button id="modeMarks" onclick="setCalcMode('Marks')" class="flex-1 py-1.5 text-xs font-semibold rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition">
                            Input Raw Marks (0-100)
                        </button>
                    </div>

                    <form id="psleCalcForm" class="space-y-4">
                        <!-- English -->
                        <div class="p-3.5 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-100 dark:border-slate-800">
                            <div class="flex justify-between items-center mb-2">
                                <label class="font-semibold text-sm text-slate-800 dark:text-slate-200 flex items-center">
                                    <i class="fas fa-book text-blue-500 mr-2"></i> English Language
                                </label>
                                <span id="el-badge" class="text-xs px-2 py-0.5 rounded font-mono font-bold bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">AL 1</span>
                            </div>
                            <div class="input-al-container">
                                <select id="el-al" onchange="calculatePSLE()" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg p-2 text-sm focus:ring-2 focus:ring-moeblue">
                                    <option value="1">AL 1 (≥ 90 marks)</option>
                                    <option value="2">AL 2 (85 - 89 marks)</option>
                                    <option value="3">AL 3 (80 - 84 marks)</option>
                                    <option value="4">AL 4 (75 - 79 marks)</option>
                                    <option value="5">AL 5 (65 - 74 marks)</option>
                                    <option value="6">AL 6 (45 - 64 marks)</option>
                                    <option value="7">AL 7 (20 - 44 marks)</option>
                                    <option value="8">AL 8 (&lt; 20 marks)</option>
                                    <option value="FA">Foundation AL A (65 - 100)</option>
                                    <option value="FB">Foundation AL B (30 - 64)</option>
                                    <option value="FC">Foundation AL C (&lt; 30)</option>
                                </select>
                            </div>
                            <div class="input-marks-container hidden">
                                <input type="number" id="el-marks" min="0" max="100" value="85" oninput="calculatePSLE()" placeholder="Enter marks (0-100)" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg p-2 text-sm">
                            </div>
                        </div>

                        <!-- Mathematics -->
                        <div class="p-3.5 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-100 dark:border-slate-800">
                            <div class="flex justify-between items-center mb-2">
                                <label class="font-semibold text-sm text-slate-800 dark:text-slate-200 flex items-center">
                                    <i class="fas fa-calculator text-emerald-500 mr-2"></i> Mathematics
                                </label>
                                <span id="ma-badge" class="text-xs px-2 py-0.5 rounded font-mono font-bold bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">AL 1</span>
                            </div>
                            <div class="input-al-container">
                                <select id="ma-al" onchange="calculatePSLE()" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg p-2 text-sm focus:ring-2 focus:ring-moeblue">
                                    <option value="1">AL 1 (≥ 90 marks)</option>
                                    <option value="2">AL 2 (85 - 89 marks)</option>
                                    <option value="3">AL 3 (80 - 84 marks)</option>
                                    <option value="4">AL 4 (75 - 79 marks)</option>
                                    <option value="5">AL 5 (65 - 74 marks)</option>
                                    <option value="6">AL 6 (45 - 64 marks)</option>
                                    <option value="7">AL 7 (20 - 44 marks)</option>
                                    <option value="8">AL 8 (&lt; 20 marks)</option>
                                    <option value="FA">Foundation AL A (65 - 100)</option>
                                    <option value="FB">Foundation AL B (30 - 64)</option>
                                    <option value="FC">Foundation AL C (&lt; 30)</option>
                                </select>
                            </div>
                            <div class="input-marks-container hidden">
                                <input type="number" id="ma-marks" min="0" max="100" value="88" oninput="calculatePSLE()" placeholder="Enter marks (0-100)" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg p-2 text-sm">
                            </div>
                        </div>

                        <!-- Science -->
                        <div class="p-3.5 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-100 dark:border-slate-800">
                            <div class="flex justify-between items-center mb-2">
                                <label class="font-semibold text-sm text-slate-800 dark:text-slate-200 flex items-center">
                                    <i class="fas fa-flask text-purple-500 mr-2"></i> Science
                                </label>
                                <span id="sc-badge" class="text-xs px-2 py-0.5 rounded font-mono font-bold bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">AL 1</span>
                            </div>
                            <div class="input-al-container">
                                <select id="sc-al" onchange="calculatePSLE()" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg p-2 text-sm focus:ring-2 focus:ring-moeblue">
                                    <option value="1">AL 1 (≥ 90 marks)</option>
                                    <option value="2">AL 2 (85 - 89 marks)</option>
                                    <option value="3">AL 3 (80 - 84 marks)</option>
                                    <option value="4" selected>AL 4 (75 - 79 marks)</option>
                                    <option value="5">AL 5 (65 - 74 marks)</option>
                                    <option value="6">AL 6 (45 - 64 marks)</option>
                                    <option value="7">AL 7 (20 - 44 marks)</option>
                                    <option value="8">AL 8 (&lt; 20 marks)</option>
                                    <option value="FA">Foundation AL A (65 - 100)</option>
                                    <option value="FB">Foundation AL B (30 - 64)</option>
                                    <option value="FC">Foundation AL C (&lt; 30)</option>
                                </select>
                            </div>
                            <div class="input-marks-container hidden">
                                <input type="number" id="sc-marks" min="0" max="100" value="78" oninput="calculatePSLE()" placeholder="Enter marks (0-100)" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg p-2 text-sm">
                            </div>
                        </div>

                        <!-- Mother Tongue -->
                        <div class="p-3.5 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-100 dark:border-slate-800">
                            <div class="flex justify-between items-center mb-2">
                                <label class="font-semibold text-sm text-slate-800 dark:text-slate-200 flex items-center">
                                    <i class="fas fa-language text-amber-500 mr-2"></i> Mother Tongue
                                </label>
                                <span id="mt-badge" class="text-xs px-2 py-0.5 rounded font-mono font-bold bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">AL 1</span>
                            </div>
                            <div class="input-al-container">
                                <select id="mt-al" onchange="calculatePSLE()" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg p-2 text-sm focus:ring-2 focus:ring-moeblue">
                                    <option value="1">AL 1 (≥ 90 marks)</option>
                                    <option value="2">AL 2 (85 - 89 marks)</option>
                                    <option value="3" selected>AL 3 (80 - 84 marks)</option>
                                    <option value="4">AL 4 (75 - 79 marks)</option>
                                    <option value="5">AL 5 (65 - 74 marks)</option>
                                    <option value="6">AL 6 (45 - 64 marks)</option>
                                    <option value="7">AL 7 (20 - 44 marks)</option>
                                    <option value="8">AL 8 (&lt; 20 marks)</option>
                                    <option value="FA">Foundation AL A (65 - 100)</option>
                                    <option value="FB">Foundation AL B (30 - 64)</option>
                                    <option value="FC">Foundation AL C (&lt; 30)</option>
                                </select>
                            </div>
                            <div class="input-marks-container hidden">
                                <input type="number" id="mt-marks" min="0" max="100" value="82" oninput="calculatePSLE()" placeholder="Enter marks (0-100)" class="w-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg p-2 text-sm">
                            </div>
                        </div>

                        <!-- Higher Mother Tongue Checkbox -->
                        <div class="p-3 bg-red-50 dark:bg-red-950/40 rounded-xl border border-red-100 dark:border-red-900 flex items-center justify-between">
                            <label for="hmt-pass" class="text-xs font-semibold text-slate-800 dark:text-slate-200 flex items-center">
                                <i class="fas fa-award text-sgred mr-2"></i> Taking Higher Mother Tongue (HMTL)?
                            </label>
                            <select id="hmt-pass" onchange="calculatePSLE()" class="text-xs bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded p-1">
                                <option value="none">No / N.A.</option>
                                <option value="distinction">Pass - Distinction</option>
                                <option value="merit">Pass - Merit</option>
                                <option value="pass">Pass - Satisfactory</option>
                            </select>
                        </div>
                    </form>
                </div>

                <!-- RESULTS & BANDING BREAKDOWN (RIGHT 7 COLS) -->
                <div class="lg:col-span-7 space-y-6">
                    
                    <!-- TOP METRICS CARD -->
                    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-md border border-slate-200 dark:border-slate-700">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Overall PSLE Score -->
                            <div class="p-4 bg-slate-50 dark:bg-slate-900/60 rounded-xl border border-slate-100 dark:border-slate-800 text-center flex flex-col justify-center">
                                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Overall PSLE Score</span>
                                <div class="text-4xl sm:text-5xl font-extrabold text-moeblue dark:text-blue-400 my-1" id="res-score">9</div>
                                <span class="text-xs text-slate-500 dark:text-slate-400">(Best: 4 | Range: 4 to 32)</span>
                            </div>

                            <!-- Assigned Posting Group -->
                            <div class="p-4 rounded-xl border text-center flex flex-col justify-center transition" id="res-pg-card">
                                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Primary Placement</span>
                                <div class="text-2xl sm:text-3xl font-extrabold my-1" id="res-posting-group">Posting Group 3</div>
                                <span class="text-xs font-medium" id="res-pg-desc">Core subjects offered at G3 level</span>
                            </div>
                        </div>
                    </div>

                    <!-- SUBJECT LEVEL ALLOCATIONS (Full SBB G1, G2, G3) -->
                    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-md border border-slate-200 dark:border-slate-700 space-y-4">
                        <div class="flex items-center justify-between">
                            <h4 class="font-bold text-slate-900 dark:text-white flex items-center">
                                <i class="fas fa-layer-group text-sgred mr-2"></i> Individual Subject Level Allocations (Full SBB)
                            </h4>
                            <span class="text-xs text-slate-500">Sec 1 Entry Standard</span>
                        </div>

                        <p class="text-xs text-slate-600 dark:text-slate-400">
                            Under Full SBB, students take subjects at different levels (**G1**, **G2**, **G3**) matching their individual subject performance regardless of overall Posting Group.
                        </p>

                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <!-- EL Allocation -->
                            <div class="p-3 rounded-xl border bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-center">
                                <span class="block text-xs text-slate-500 mb-1">English</span>
                                <span id="alloc-el" class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">G3 Level</span>
                            </div>
                            <!-- Math Allocation -->
                            <div class="p-3 rounded-xl border bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-center">
                                <span class="block text-xs text-slate-500 mb-1">Mathematics</span>
                                <span id="alloc-ma" class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">G3 Level</span>
                            </div>
                            <!-- Science Allocation -->
                            <div class="p-3 rounded-xl border bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-center">
                                <span class="block text-xs text-slate-500 mb-1">Science</span>
                                <span id="alloc-sc" class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">G3 Level</span>
                            </div>
                            <!-- MT Allocation -->
                            <div class="p-3 rounded-xl border bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-center">
                                <span class="block text-xs text-slate-500 mb-1">Mother Tongue</span>
                                <span id="alloc-mt" class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">G3 Level</span>
                            </div>
                        </div>
                    </div>

                    <!-- PATHWAY ELIGIBILITY CHECKLIST -->
                    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-md border border-slate-200 dark:border-slate-700 space-y-4">
                        <h4 class="font-bold text-slate-900 dark:text-white flex items-center">
                            <i class="fas fa-check-circle text-emerald-500 mr-2"></i> Secondary School Pathway Qualification Status
                        </h4>

                        <div class="space-y-2.5 text-sm" id="eligibility-list">
                            <!-- Populated dynamically by JavaScript -->
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- TAB 2: INTERACTIVE FLOWCHART & DIAGRAM    -->
        <!-- ========================================== -->
        <section id="tab-flowchart" class="tab-content hidden space-y-8">
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-md border border-slate-200 dark:border-slate-700">
                <div class="mb-6">
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center">
                        <i class="fas fa-sitemap text-moeblue dark:text-blue-400 mr-3"></i> Post-PSLE Journey & Progression Flowchart
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                        Click on any node in the interactive diagram below to reveal details about entry requirements, exams, and progression options.
                    </p>
                </div>

                <!-- Interactive Flowchart Canvas / Grid -->
                <div class="space-y-6 relative overflow-x-auto p-4 bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-slate-200 dark:border-slate-800">
                    
                    <!-- STEP 1: PRIMARY 6 -->
                    <div>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2">Stage 1: Primary 6 Milestones</span>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div onclick="showNodeDetail('dsa-node')" class="flowchart-node cursor-pointer p-4 bg-white dark:bg-slate-800 rounded-xl border-2 border-purple-500 shadow-sm flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300 flex items-center justify-center font-bold">
                                        DSA
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-sm text-slate-900 dark:text-white">Direct School Admission (DSA-Sec)</h4>
                                        <p class="text-xs text-slate-500">Talent-based entry before PSLE (May - Oct)</p>
                                    </div>
                                </div>
                                <i class="fas fa-chevron-right text-slate-400"></i>
                            </div>

