            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-btn-${tabId}`);
            activeBtn.classList.add('active', 'bg-blue-50', 'text-moeblue', 'dark:bg-slate-700', 'dark:text-blue-400');
        }

        // Mode Switcher (AL vs Marks)
        function setCalcMode(mode) {
            currentMode = mode;
            if (mode === 'AL') {
                document.getElementById('modeAL').className = 'flex-1 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm transition';
                document.getElementById('modeMarks').className = 'flex-1 py-1.5 text-xs font-semibold rounded-lg text-slate-600 dark:text-slate-400 transition';
                document.querySelectorAll('.input-al-container').forEach(el => el.classList.remove('hidden'));
                document.querySelectorAll('.input-marks-container').forEach(el => el.classList.add('hidden'));
            } else {
                document.getElementById('modeMarks').className = 'flex-1 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm transition';
                document.getElementById('modeAL').className = 'flex-1 py-1.5 text-xs font-semibold rounded-lg text-slate-600 dark:text-slate-400 transition';
                document.querySelectorAll('.input-al-container').forEach(el => el.classList.add('hidden'));
                document.querySelectorAll('.input-marks-container').forEach(el => el.classList.remove('hidden'));
            }
            calculatePSLE();
        }

        // Convert Marks to AL Grade
        function marksToAL(marks) {
            const m = parseFloat(marks);
            if (isNaN(m)) return 8;
            if (m >= 90) return 1;
            if (m >= 85) return 2;
            if (m >= 80) return 3;
            if (m >= 75) return 4;
            if (m >= 65) return 5;
            if (m >= 45) return 6;
            if (m >= 20) return 7;
            return 8;
        }

        // Convert Select Value to Points & Display Badge
        function parseSubjectInput(subjId) {
            if (currentMode === 'AL') {
                const val = document.getElementById(`${subjId}-al`).value;
                if (val === 'FA') return { score: 6, label: 'Foundation A (AL6)' };
                if (val === 'FB') return { score: 7, label: 'Foundation B (AL7)' };
                if (val === 'FC') return { score: 8, label: 'Foundation C (AL8)' };
                return { score: parseInt(val), label: `AL ${val}` };
            } else {
                const marks = document.getElementById(`${subjId}-marks`).value;
                const al = marksToAL(marks);
                return { score: al, label: `AL ${al} (${marks || 0}m)` };
            }
        }

        // MAIN PSLE & FULL SBB CALCULATOR LOGIC
        function calculatePSLE() {
            const el = parseSubjectInput('el');
            const ma = parseSubjectInput('ma');
            const sc = parseSubjectInput('sc');
            const mt = parseSubjectInput('mt');

            // Update Badges
            document.getElementById('el-badge').innerText = el.label;
            document.getElementById('ma-badge').innerText = ma.label;
            document.getElementById('sc-badge').innerText = sc.label;
            document.getElementById('mt-badge').innerText = mt.label;

            // Total Score Calculation
            const totalScore = el.score + ma.score + sc.score + mt.score;
            document.getElementById('res-score').innerText = totalScore;

            // Determine Posting Group
            let pg = 3;
            let pgTitle = 'Posting Group 3';
            let pgDesc = 'Core subjects offered at G3 level (Express Standard)';
            let cardBgClass = 'bg-emerald-50 border-emerald-300 text-emerald-900 dark:bg-emerald-950/40 dark:border-emerald-800 dark:text-emerald-200';

            if (totalScore <= 20) {
                pg = 3;
                pgTitle = 'Posting Group 3';
                pgDesc = 'Core subjects predominantly taken at G3 level';
                cardBgClass = 'bg-emerald-50 border-emerald-300 text-emerald-900 dark:bg-emerald-950/40 dark:border-emerald-800 dark:text-emerald-200';
            } else if (totalScore <= 24) {
                pg = 2;
                pgTitle = 'Posting Group 2';
                pgDesc = 'Core subjects predominantly taken at G2 level';
                cardBgClass = 'bg-blue-50 border-blue-300 text-blue-900 dark:bg-blue-950/40 dark:border-blue-800 dark:text-blue-200';
            } else if (totalScore <= 30) {
                pg = 1;
                pgTitle = 'Posting Group 1';
                pgDesc = 'Core subjects predominantly taken at G1 level';
                cardBgClass = 'bg-amber-50 border-amber-300 text-amber-900 dark:bg-amber-950/40 dark:border-amber-800 dark:text-amber-200';
            } else {
                pg = 0;
                pgTitle = 'Specialised Pathway';
                pgDesc = 'Eligible for Specialised Schools (Crest / Spectrum) or re-sitting';
                cardBgClass = 'bg-slate-100 border-slate-300 text-slate-800 dark:bg-slate-800 dark:border-slate-600 dark:text-slate-200';
            }

            document.getElementById('res-posting-group').innerText = pgTitle;
            document.getElementById('res-pg-desc').innerText = pgDesc;
            document.getElementById('res-pg-card').className = `p-4 rounded-xl border text-center flex flex-col justify-center transition ${cardBgClass}`;

            // Calculate Subject Level Allocations (Full SBB rules)
            updateSubjectLevelBadge('alloc-el', el.score, pg);
            updateSubjectLevelBadge('alloc-ma', ma.score, pg);
            updateSubjectLevelBadge('alloc-sc', sc.score, pg);
            updateSubjectLevelBadge('alloc-mt', mt.score, pg);

            // Pathway Eligibility Checklist Generator
            renderEligibilityChecklist(totalScore, el.score, ma.score, sc.score, mt.score);
        }

        // Helper: Subject Level Assignment (MOE SBB Rules)
        function updateSubjectLevelBadge(elementId, subjectAL, defaultPG) {
            const el = document.getElementById(elementId);
            let level = 'G3';
            let css = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';

            // MOE Rule: Standard AL 1-5 qualifies for G3. AL 6 qualifies for G2. AL 7-8 qualifies for G1.
            if (subjectAL <= 5) {
                level = 'G3 Level';
                css = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300';
            } else if (subjectAL === 6) {
                level = defaultPG === 3 ? 'G3 Level' : 'G2 Level';
                css = level === 'G3 Level' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
            } else {
                level = defaultPG === 1 ? 'G1 Level' : (defaultPG === 2 ? 'G2 Level' : 'G3 Level');
                if (level === 'G1 Level') css = 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300';
                else if (level === 'G2 Level') css = 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300';
            }

            el.innerText = level;
            el.className = `inline-block px-3 py-1 rounded-full text-xs font-bold ${css}`;
        }

        // Render Pathway Checklist Status
        function renderEligibilityChecklist(totalScore, elAL, maAL, scAL, mtAL) {
            const container = document.getElementById('eligibility-list');
            const hmt = document.getElementById('hmt-pass').value;

            const pathways = [
                {
                    name: 'Integrated Programme (IP - 6 Year Direct Track)',
                    eligible: totalScore <= 8,
                    note: totalScore <= 8 ? 'Highly Competitive Eligible (Target AL 4-8 range)' : 'Typically requires AL 4 - 8'
                },
                {
                    name: 'Full SBB - Posting Group 3 (Formerly Express)',
                    eligible: totalScore <= 20,
                    note: totalScore <= 20 ? 'Qualified for PG3 mainstream secondary' : 'Requires PSLE score ≤ 20'
                },
                {
                    name: 'Full SBB - Posting Group 2 (Formerly Normal Academic)',
                    eligible: totalScore <= 24,
                    note: totalScore <= 24 ? 'Qualified for PG2 mainstream secondary' : 'Requires PSLE score ≤ 24'
                },
                {
                    name: 'Full SBB - Posting Group 1 (Formerly Normal Technical)',
                    eligible: totalScore <= 30 && elAL <= 7 && maAL <= 7,
                    note: totalScore <= 30 ? 'Qualified for PG1 mainstream secondary' : 'Requires PSLE score ≤ 30'
                },
                {
                    name: 'NUS High School of Math & Science',
                    eligible: totalScore <= 8 && maAL <= 2 && scAL <= 2,
                    note: 'Requires top Math & Science AL scores + DSA selection'
                },
                {
                    name: 'School of the Arts (SOTA) / Singapore Sports School',
                    eligible: totalScore <= 22,
                    note: 'Subject to DSA audition / sports trial clearance'
                },
                {
                    name: 'Specialised Schools (Crest Secondary / Spectra Secondary)',
                    eligible: totalScore >= 25 || elAL >= 7 || maAL >= 7,
                    note: 'Hands-on experiential learning focus for PG1 eligible students'
                }
            ];

            container.innerHTML = pathways.map(p => `
                <div class="flex items-center justify-between p-3 rounded-xl ${p.eligible ? 'bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900' : 'bg-slate-50 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 opacity-75'}">
                    <div class="flex items-center space-x-3">
                        <i class="fas ${p.eligible ? 'fa-check-circle text-emerald-600 dark:text-emerald-400' : 'fa-times-circle text-slate-400'} text-lg"></i>
                        <div>
                            <span class="font-semibold text-slate-900 dark:text-white block text-xs sm:text-sm">${p.name}</span>
                            <span class="text-[11px] text-slate-500 dark:text-slate-400">${p.note}</span>
                        </div>
                    </div>
                    <span class="text-xs font-bold px-2.5 py-1 rounded-full ${p.eligible ? 'bg-emerald-200 text-emerald-900 dark:bg-emerald-900 dark:text-emerald-100' : 'bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-300'}">
                        ${p.eligible ? 'Eligible' : 'Not Met'}
                    </span>
                </div>
            `).join('');
        }

        // Reset Calculator Form
        function resetCalculator() {
            document.getElementById('psleCalcForm').reset();
            calculatePSLE();
        }

        // Show Node Details in Flowchart
        function showNodeDetail(nodeId) {
            const detail = nodeDetails[nodeId];
            if (detail) {
                document.getElementById('nodeDetailTitle').innerText = detail.title;
                document.getElementById('nodeDetailBody').innerText = detail.body;
            }
        }

        // DSA Talent Finder Filters
        function filterDSA(category) {
            document.querySelectorAll('.dsa-btn').forEach(btn => {
                btn.className = 'dsa-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-200';
            });
            event.target.className = 'dsa-btn active px-3 py-1.5 text-xs font-bold rounded-lg bg-purple-600 text-white';

            if (category === 'all') {
                renderDSACards(dsaData);
            } else {
                const filtered = dsaData.filter(item => item.category === category);
                renderDSACards(filtered);
            }
        }

        // Render DSA Cards Grid
        function renderDSACards(items) {
            const grid = document.getElementById('dsaCardsGrid');
            grid.innerHTML = items.map(item => `
                <div class="bg-slate-50 dark:bg-slate-900/60 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300 flex items-center justify-center font-bold">
                                <i class="fas ${item.icon} text-lg"></i>
                            </div>
                            <h4 class="font-bold text-slate-900 dark:text-white text-base">${item.title}</h4>
                        </div>
                        <span class="text-[10px] uppercase font-bold px-2.5 py-1 rounded-full ${item.badgeBg}">${item.category}</span>
                    </div>

                    <p class="text-xs text-slate-600 dark:text-slate-300">${item.description}</p>

                    <div>
                        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 block mb-1">Notable Participating Schools:</span>
                        <div class="flex flex-wrap gap-1.5">
                            ${item.schools.map(s => `<span class="text-[11px] bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2 py-0.5 rounded text-slate-700 dark:text-slate-300">${s}</span>`).join('')}
                        </div>
                    </div>

                    <div class="pt-2 border-t border-slate-200 dark:border-slate-700">
                        <span class="text-xs font-bold text-slate-800 dark:text-slate-200 block mb-2"><i class="fas fa-list-check text-purple-600 mr-1"></i> Recommended Portfolio Checklist:</span>
                        <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
                            ${item.checklist.map(c => `<li class="flex items-start"><i class="fas fa-check text-emerald-500 mr-2 mt-0.5"></i> <span>${c}</span></li>`).join('')}
                        </ul>
                    </div>
                </div>
            `).join('');
        }
    </script>
</body>
